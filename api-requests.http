@baseUrl = http://localhost:8080
@employeeId = e1000000-0000-0000-0000-000000000001
@leaveId = l1000000-0000-0000-0000-000000000001

### ========== EMPLOYEES ==========
GET {{baseUrl}}/employees

###
GET {{baseUrl}}/employees?page=0&size=5&sortBy=firstName&sortDir=asc

###
GET {{baseUrl}}/employees/{{employeeId}}

###
POST {{baseUrl}}/employees
Content-Type: application/json

{"firstName": "John", "lastName": "Doe", "email": "john.doe@example.com"}

###
PATCH {{baseUrl}}/employees/{{employeeId}}
Content-Type: application/json

{"firstName": "Alice", "lastName": "Smith", "email": "alice@example.com"}

###
DELETE {{baseUrl}}/employees/{{employeeId}}

###
GET {{baseUrl}}/employees/{{employeeId}}/leave

###
POST {{baseUrl}}/employees/{{employeeId}}/leave
Content-Type: application/json

{"startDate": "2025-03-01", "endDate": "2025-03-05", "type": "ANNUAL_LEAVE", "employeeId": "{{employeeId}}"}

### ========== LEAVES ==========
POST {{baseUrl}}/leaves
Content-Type: application/json

{"startDate": "2025-04-01", "endDate": "2025-04-03", "type": "SICK_LEAVE", "employeeId": "{{employeeId}}"}

###
GET {{baseUrl}}/leaves/{{leaveId}}

###
PATCH {{baseUrl}}/leaves/{{leaveId}}/approve

###
PATCH {{baseUrl}}/leaves/{{leaveId}}/reject
